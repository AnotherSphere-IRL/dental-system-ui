const INVENTORY_BY_NAME = new Map(ACTIVE_INVENTORY_ROWS.map(item => [item.name, item]));

function getDeliveryItems(order: MonitorOrder) {
  const primaryItem = INVENTORY_BY_NAME.get(order.itemName);
  if (!primaryItem) return [];
  const primaryIsPerishable = primaryItem.expiry !== 'none';
  const mixedItem = ACTIVE_INVENTORY_ROWS.find(item =>
    item.id !== primaryItem.id && (item.expiry !== 'none') !== primaryIsPerishable
  );
  return mixedItem ? [primaryItem, mixedItem] : [primaryItem];
}

function StatusBadge({ order }: { order: MonitorOrder }) {
  const statusClass = order.status === 'action'
    ? 'border-alert-100 bg-alert-50 text-alert-700'
    : order.status === 'completed'
      ? 'border-success-100 bg-success-50 text-success-700'
      : order.statusLabel === 'Being delivered'
        ? 'border-primary-100 bg-primary-50 text-primary-700'
        : 'border-warning-100 bg-warning-50 text-warning-700';
  const Icon = order.status === 'action' ? IconAlert : order.status === 'completed' ? IconCheck : order.statusLabel === 'Being delivered' ? IconTruck : IconClock;
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold ${statusClass}`}>
      <Icon className="h-3.5 w-3.5" />
      {order.statusLabel}
    </span>
  );
}

function Overlay({ children, align = 'right', onClose }: { children: ReactNode; align?: 'right' | 'center'; onClose: () => void }) {
  useEffect(() => {
    const closeOnEscape = (event: KeyboardEvent) => event.key === 'Escape' && onClose();
    window.addEventListener('keydown', closeOnEscape);
    return () => window.removeEventListener('keydown', closeOnEscape);
  }, [onClose]);

  return (
    <div className={`fixed inset-0 z-50 flex ${align === 'right' ? 'justify-end' : 'items-center justify-center p-6'}`}>
      <button aria-label="Close overlay" onClick={onClose} className="absolute inset-0 bg-clinical-900/30" />
      {children}
    </div>
  );
}

